import fs from 'node:fs';
import path from 'node:path';

const ROOT = process.cwd();
const ENV = process.env.NODE_ENV || 'development';

const state = {
  root: ROOT,
  env: ENV,
  ready: false,
};

function ensureDir(dir) {
  try {
    if (!fs.existsSync(dir)) {
      fs.mkdirSync(dir, { recursive: true });
    }
  } catch {
    // Best-effort directory setup; the app can continue without it.
  }
}

function init(options = {}) {
  if (state.ready) return state;
  state.env = options.env || process.env.NODE_ENV || state.env;
  state.root = options.root || process.cwd();
  ensureDir(path.join(state.root, '.tmp'));
  state.ready = true;
  return state;
}

init();

export { ensureDir, init, state };
export default { init, state };
